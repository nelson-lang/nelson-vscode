{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": ["m"],
  "name": "Nelson",
  "patterns": [
    {
      "include": "#transpose"
    },
    {
      "include": "#misc"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#parentheses"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#number"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "misc": {
      "patterns": [
        {
          "match": "\\.\\.\\.\\s*$",
          "name": "punctuation.separator.continuation.nelson"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "begin": "(\\[)",
          "beginCaptures": {
            "1": {
              "name": "meta.bracket.nelson"
            }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": {
              "name": "meta.bracket.nelson"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    },
    "parentheses": {
      "patterns": [
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": {
              "name": "meta.bracket.nelson"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "meta.bracket.nelson"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(and|arguments|break|else|elseif|end|false|for|if|not|or|function|return|true|while|switch|continue|case|otherwise|which|varargin|varargout|classdef|methods|properties)\\b",
          "name": "keyword.control.nelson"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.nelson",
          "match": "\\b(COM_xlsfinfo|COM_xlsformat|COM_xlsread|COM_xlswrite|SEEK_CUR|SEEK_END|SEEK_SET|abcdchk|acker|acosd|acosh|acot|acotd|acoth|acsc|acscd|acsch|addtodate|angle|array2table|asec|asecd|asech|asind|asinh|atan2d|atand|augstate|balreal|bandwidth|bartlett|bdschur|bernsteinMatrix|blackman|blkdiag|bode|buildhelp|buildhelpjson|buildhelpmd|buildhelpweb|c2d|care|cart2pol|cart2sph|cat|cell2mat|cell2table|celldisp|cellstr|checkupdate|circshift|cloop|cmake|cmdsep|compreal|cond|condeig|configureDictionary|configuremingw|configuremsvc|contourc|contourf|conv|cosd|cospi|cot|cotd|coth|cov|cross|csc|cscd|csch|csvread|csvwrite|ctrb|ctrbf|d2c|damp|dare|date|db2mag|db2pow|dcgain|deal|deconv|deg2rad|deployhelp|dictionary|diff|dlgeneratecleaner|dlgenerategateway|dlgenerateloader|dlgeneratemake|dlgeneratemexgateway|dlgenerateunloader|dlgetnelsonincludes|dlgetnelsonlibraries|dlmake|dlqr|dlyap|doc|dot|downsample|dsort|entries|eomday|esort|etime|evalfr|exist|f2c|factor|factorial|feedback|fft2|fftn|fftshift|filter|filter2|findcmake|findobj|findpeaks|flip|flipdim|formattedDisplayText|freqresp|gallery|gensig|gradient|gram|h5dump|h5ls|hadamard|hamming|hankel|hann|havecompiler|head|height|help|hilb|hour|hsvd|ifftn|ifftshift|im2double|impulse|ind2sub|initial|insert|interp1|interp2|interp3|interpn|invhilb|ipermute|isConfigured|isKey|isStringScalar|isbanded|iscolumn|iscom|isct|isdiag|isdt|islti|ismatrix|isplaying|isrow|issiso|issorted|isspace|isstatic|istable|istril|istriu|isunicodesupported|jlenv|kalman|keys|kron|leapyear|license|lin2mu|loadcompilerconf|logspace|lookup|lqe|lqed|lqr|lqry|ls|lsim|lyap|mag2db|magic|maxk|meshgrid|mex|mink|minreal|minute|mpiexec|mu2lin|ndgrid|newline|nextpow2|nexttile|nig|nig_header_license|nig_version|nmm|nmm_build_dependencies|nmm_build_help|nmm_build_loader|normest|normpdf|nthroot|num2cell|numEntries|nyquist|obsv|obsvf|ord2|orderfields|orth|padecoef|parallel|pascal|peaks|pinv|planerot|poheader|pol2cart|pole|poly|polyder|polyfit|polyint|polyval|polyval