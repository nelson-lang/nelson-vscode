        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "entity.name.function.nelson",
          "match": "\\b(AfterAllFuture_used|AfterEachFuture_used|COM_range|COM_used|FFTWwrapper|FevalFuture_used|FevalFuture_used|FevalQueue_used|IJV|Inf|MException|MPI_Allreduce|MPI_Barrier|MPI_Bcast|MPI_Comm_get_name|MPI_Comm_object|MPI_Comm_rank|MPI_Comm_size|MPI_Comm_split|MPI_Comm_used|MPI_Finalize|MPI_Get_library_version|MPI_Get_processor_name|MPI_Get_version|MPI_Init|MPI_Initialized|MPI_Iprobe|MPI_Probe|MPI_Recv|MPI_Reduce|MPI_Send|NaN|abs|acos|acquirevar|actxGetRunningServer|actxcontrollist|actxserver|actxserverlist|addgateway|addmodule|addpath|afterAll|afterEach|all|allbetween|allfinite|and|any|append|argv|arrayfun|asin|assert|assert_checkerror|assert_isapprox|assert_isequal|assert_isfalse|assert_istrue|assignin|atan|atan2|atanh|audiodevinfo|audioinfo|audiometadata|audioplayer|audioplayer_used|audioread|audiorecorder|audiorecorder_used|audiosupportedformats|audiowrite|backgroundPool|backgroundPool_used|balance|banner|base2dec|beep|betainc|bin2dec|bin2num|bitand|bitor|bitxor|blanks|builtin|calendar|cancel|cancelAll|cast|cd|ceil|cell|cell2struct|cellfun|char|chol|class|clc|clear|clearfun|clock|colon|complex|computer|conj|consolebox|contains|conv2|convertCharsToStrings|convertStringToCharArgs|convertStringsToChars|copyfile|corrcoef|cos|cosh|cosm|count|cputime|crc32|createGUID|ctranspose|cumprod|cumsum|datenum|datestr|datevec|dbclear|dbcont|dbdown|dbquit|dbstack|dbstatus|dbstep|dbstop|dbup|deblank|dec2base|dec2bin|dec2hex|delete|det|detectImportOptions|diag|diary|diff_file|dir|disp|display|dlcall|dlclose|dllib_used|dllibinfo|dllibisloaded|dlmread|dlmwrite|dlopen|dlsym|dlsym_used|docroot|dos|double|echo|eig|endsWith|eps|eq|erf|erfc|erfcinv|erfcx|erfinv|error|eval|evalc|evalin|execstr|exit|exp|expm|eye|false|fclose|feature|feof|ferror|fetchNext|fetchOutputs|feval|fft|fftw|fgetl|fgets|fieldnames|fileparts|fileread|filesep|filewrite|find|fix|flintmax|fliplr|flipud|floor|fopen|format|fprintf|fread|frewind|fscanf|fseek|fsize|ftell|full|fullfile|fullpath|func2str|fwrite|gamma|gammaln|gatewayinfo|gcd|ge|get|getLastReport|getaudiodata|getavailablelanguages|getdefaultlanguage|getdynlibext|getenv|getfield|getlanguage|getmodules|getnelsonmode|getpid|getplayer|gettext|global|gt|h5create|h5read|h5readatt|h5write|h5writeatt|headcomments|hex2dec|horzcat|hostname|htmltopdf|hypot|i|i18nHelpers|ifft|imag|imresize|imrotate|inf|inmem|input|inputname|int16|int2str|int32|int64|int8|intmax|intmin|inv|invoke|ipc|isNull|isa|isapprox|isbetween|isbuiltin|iscell|iscellstr|ischar|isclass|isdir|isdouble|isempty|isequal|isequaln|isequalto|isfield|isfile|isfinite|isfloat|isfolder|isfunction_handle|isglobal|ishandle|ishermitian|isinf|isint16|isint32|isint64|isint8|isinteger|iskeyword|isletter|islogical|ismac|ismacro|ismatfile|ismember|ismethod|ismex|ismissing|ismodule|isnan|isnh5file|isnumeric|isobject|ispc|isprop|isquietmode|isreal|isrecording|isscalar|issingle|issparse|isstring|isstruct|issymmetric|isuint16|isuint32|isuint64|isuint8|isunix|isvalid|isvar|isvarname|isvector|j|jlrun|jlrunfile|join|jsondecode|jsonencode|jsonprettyprint|keyHash|keyMatch|lasterror|lastwarn|ldivide|le|length|libpointer|libpointer_used|linspace|load|loadenv|loadmat|loadnh5|log|log10|log1p|log2|logical|logm|lower|lt|lu|macroargs|markdown|mat2str|matches|max|maxNumCompThreads|max_recursion_depth|mean|memory|methods|mexext|mfilename|min|minus|missing|mkdir|mldivide|mod|modulepath|mpower|mrdivide|mtimes|mustBeA|mustBeBetween|mustBeColumn|mustBeFile|mustBeFinite|mustBeFloat|mustBeFolder|mustBeGreaterThan|mustBeGreaterThanOrEqual|mustBeInRange|mustBeInteger|mustBeLessThan|mustBeLessThanOrEqual|mustBeLogical|mustBeLogicalScalar|mustBeMatrix|mustBeMember|mustBeNegative|mustBeNonNan|mustBeNonSparse|mustBeNonZero|mustBeNonempty|mustBeNonmissing|mustBeNonnegative|mustBeNonpositive|mustBeNonzeroLengthText|mustBeNumeric|mustBeNumericOrLogical|mustBePositive|mustBeReal|mustBeRow|mustBeScalarOrEmpty|mustBeSparse|mustBeText|mustBeTextScalar|mustBeValidVariableName|mustBeVector|namedargs2cell|namelengthmax|nan|nargin|narginchk|nargout|nargoutchk|native2unicode|nativecharset|ndims|ne|nelsonappid|nelsonroot|nfilename|nnz|norm|not|now|num2bin|num2str|numel|nzmax|onCleanup|ones|or|parfeval|parsefile|parsestring|path|pathsep|pause|permute|persistent|pi|play|playblocking|plus|power|prefdir|prod|profile|profsave|properties|pwd|pyrun|pyrunfile|quit|rand|randi|randn|rcond|rdivide|readcell|readmatrix|readtable|real|realmax|realmin|record|recordblocking|regexp|regexpi|regexprep|regexptranslate|regextranslate|rehash|relativepath|rem|removegateway|removemodule|renameStructField|replace|repmat|repo|requiremodule|reshape|restoredefaultpath|resume|rethrow|rmdir|rmfield|rmfile|rmpath|rng|round|run|save|savemat|savenh5|schur|searchenv|semver|set|setenv|setlanguage|sha256|sign|sin|single|sinh|sinm|size|sleep|slicot_ab01od|slicot_ab04md|slicot_ab07nd|slicot_ab07nd|slicot_ab08nd|slicot_ag08bd|slicot_mb02md|slicot_mb03od|slicot_mb03pd|slicot_mb03rd|slicot_mb04gd|slicot_mb04md|slicot_mb05od|slicot_mc01td|slicot_sb01bd|slicot_sb02od|slicot_sb03md|slicot_sb03od|slicot_sb04md|slicot_sb04qd|slicot_sb10jd|slicot_sg02ad|slicot_tb01id|slicot_tg01ad|sort|sparse|sprintf|sqrt|sqrtm|sscanf|startsWith|stop|str2double|str2func|strcat|strcmp|strcmpi|strfind|string|strings|strjust|strlength|strncmp|strncmpi|strrep|strtrim|struct|struct2cell|subsasgn|subsasgn|subsref|sum|svd|swapbytes|system|tan|tanh|tanm|tempdir|terminal_size|test_parsetags|throw|throwAsCaller|tic|time|timeit|times|toc|tolower|toolboxdir|toupper|trace|transpose|tril|triu|true|uint16|uint32|uint64|uint8|uminus|unicode2native|unique|unix|unzip|uplus|upper|userdir|usermodulesdir|username|userpath|var|varislock|varlock|varunlock|version|vertcat|wait|warning|webREST|what|which|who|whomat|whonh5|whos|whosmat|whosnh5|winopen|winqueryreg|writetable|xmlchecker|xmldocbuild|xmldocmergesummary|xmlprettyprint|xmltransform|xor|zeros|zip)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\s*(?:<|<=|=|==|>=|>|~=)\\s*",
          "name": "keyword.operator.relation.nelson"
        },
        {
          "match": "\\s*(?:\\+|-|\\*|/|\\\\|\\^)\\s*",
          "name": "keyword.operator.arithmetic.nelson"
        },
        {
          "match": "\\s*(?:\\|\\||&&)\\s*",
          "name": "keyword.operator.boolean.nelson"
        },
        {
          "match": "(?:\\.\\.\\.|\\=|:|\\~|@)",
          "name": "keyword.other.nelson"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "number: hexa, octal, decimal, double, scientific and complex numbers",
          "match": "((\\b0x[0-9a-fA-F]+\\b)|(\\b0o[0-7]+\\b)|((\\b[0-9]+\\.?[0-9]*)|(\\.[0-9]+))([eE][+-]?[0-9]+)?([ij])?)",
          "name": "constant.numeric.nelson"
        }
      ]
    },
    "transpose": {
      "match": "(\\]|\\))((?:\\.)?'*)",
      "name": "keyword.operator.transpose.nelson"
    },
    "strings": {
      "patterns": [
        {
          "begin": "(?<![\\w\\])])'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nelson"
            }
          },
          "end": "'(?!')",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nelson"
            }
          },
          "name": "string.quoted.single.nelson",
          "patterns": [
            {
              "match": "''|\"\"",
              "name": "constant.character.escape.nelson"
            }
          ]
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nelson"
            }
          },
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nelson"
            }
          },
          "name": "string.quoted.double.nelson",
          "patterns": [
            {
              "match": "''|\"\"",
              "name": "constant.character.escape.nelson"
            }
          ]
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "%\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.nelson"
            }
          },
          "end": "%\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.nelson"
            }
          },
          "name": "comment.block.percentage.nelson"
        },
        {
          "begin": "%",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.nelson"
            }
          },
          "end": "\\n",
          "name": "comment.line.percentage.nelson"
        }
      ]
    }
  },
  "scopeName": "source.nelson"
}
