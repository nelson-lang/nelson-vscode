{
  "For Loop": {
    "prefix": "for",
    "body": ["for ${1:index} = ${2:initVal}:${3:endVal}", "\t$0", "end"],
    "description": "For loop to repeat specified number of times"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if ${1:condition}", "\t$0", "end"],
    "description": "Execute statements if condition is true"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": ["if ${1:condition}", "\t$0", "else", "\t", "end"],
    "description": "Execute some statements if condition is true, and others if statement is false"
  },
  "While Loop": {
    "prefix": "while",
    "body": ["while ${1:condition}", "\t$0", "end"],
    "description": "While loop to repeat when condition is true"
  },
  "Try-Catch Statement": {
    "prefix": "try",
    "body": ["try", "\t$0", "catch ${1:exception}", "\t", "end"],
    "description": "Execute statements and catch resulting errors"
  },
  "Switch Statement": {
    "prefix": "switch",
    "body": [
      "switch ${1:switch_expression}",
      "\tcase ${2:case_expression}",
      "\t\t$0",
      "\totherwise",
      "\t\t",
      "end"
    ],
    "description": "Execute one of several groups of statements"
  },
  "Function Definition": {
    "prefix": "function",
    "body": ["function ${1:output} = ${2:name}(${3:input})", "\t$0", "end"],
    "description": "Declare function name, inputs, and outputs"
  },
  "Arguments Block": {
    "prefix": "arguments",
    "body": ["arguments", "\t${1:argument} ${2:mustBeNumeric}", "end"],
    "description": "Validate function input arguments"
  },
  "Output Arguments Block": {
    "prefix": "argumentsout",
    "body": ["arguments (Output)", "\t${1:output} ${2:mustBeNumeric}", "end"],
    "description": "Validate function output arguments"
  },
  "Optional Argument": {
    "prefix": "argumentdefault",
    "body": [
      "arguments",
      "\t${1:name} ${2:mustBeNumeric} = ${3:defaultValue}",
      "end"
    ],
    "description": "Validate an optional argument with a default value"
  },
  "Name-Value Arguments Block": {
    "prefix": "argumentsnv",
    "body": [
      "arguments",
      "\t${1:options}.${2:name} ${3:mustBeMember} = ${4:defaultValue}",
      "end"
    ],
    "description": "Validate name-value arguments"
  }
}
